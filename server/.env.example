# 同步服务环境变量。复制为 .env 后按需修改（.env 不进版本库）。

# SQLite 文件（相对 prisma/schema.prisma 所在目录解析）
DATABASE_URL="file:./dev.db"

PORT=3901

# 若依账号系统；服务端用它校验客户端传来的 token（转发 getInfo）
RUIYI_API_URL="https://api.sakta.top"

# 允许的前端来源，逗号分隔。非生产环境下 localhost / 127.0.0.1 的任意端口总是放行。
CORS_ORIGIN="http://localhost:5173"

# 仅开发环境可开：允许 POST /api/auth/dev-token 签发本地联调用 token（生产环境恒不生效）
ALLOW_DEV_TOKEN="true"

# 仅开发环境可开：账号系统证书链在本机不被信任时跳过校验
ALLOW_INSECURE_TLS="false"

# 仅开发环境可开：暴露 Swagger（/api/docs）
ENABLE_SWAGGER="true"